- content_for :title, t("staff.page-title")
- meta :title, t("staff.meta.title")
- meta :description, t("staff.meta.description")

#staff
  %h2
    %i.fa.fa-user-md{"aria-hidden" => "true"}
    %b
      = t("staff.title")
      %small.staff-description
        = t("staff.description")
  %hr

  - if @admins.none? && @developers.none? && @mods.none? && @organizers.none?
    %h5.text-center
      = t("staff.no-members")

  - if @admins.any?
    .row.staff-group.staff-group-admin
      .col-md-12
        %h2
          = t("staff.groups.administrator")
          %small.staff-group-count
            = @admins.size
        %hr.hr-light-title/
    .row
      - @admins.each do |admin|
        .col-md-3.col-sm-6.text-center
          .staff-entry
            - if admin.profile&.profile_picture_data.present?
              = image_tag admin.profile.profile_picture_url, alt: '', class: 'staff-avatar'
            - else
              = image_tag "no_profile_picture.png", alt: '', class: 'staff-avatar'
            %br
            %a{:href => user_path(admin)}
              %h4.staff-username.staff-role-admin
                = admin.username
            .staff-social
              - if admin.profile.public_email?
                %a{"data-content" => admin.profile.public_email, "data-placement" => "bottom", "data-toggle" => "popover", style: "cursor: pointer;"}
                  %i.fa.fa-envelope{"aria-hidden" => "true"}
              - if admin.profile.discord?
                %a{"data-content" => admin.profile.discord, "data-placement" => "top", "data-toggle" => "popover", style: "cursor: pointer;"}
                  %i.fab.fa-discord{"aria-hidden" => "true"}
              - if admin.profile.github?
                %a{href: "https://github.com/#{admin.profile.github}", target: "_blank"}
                  %i.fab.fa-github{"aria-hidden" => "true"}

  - if @developers.any?
