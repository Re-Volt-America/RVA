- content_for :title, "Re-Volt America - #{@track.name}"

- meta :title, @track.name
- meta :description, t("rva.tracks.meta.show.description")
- meta :image, @track.thumbnail_url

%h2
  = title_with_season(t('rva.tracks.title'), @track.season)

= render :partial => "application/subnav", :locals => {:season => @track.season, :track => @track}

#tracks
  .container
    .row
      .col-md-6
        %h1{style: "margin-top: 0;"}
          = @track.name
        %br
        %table.car-specs-table
          %tbody
            %tr
              %td= t("misc.author")
              %td= @track.author
            %tr
              %td= t("rva.tracks.format.short-name.title")
              %td= @track.short_name
            %tr
              %td= t("rva.tracks.format.difficulty.title")
              %td= @track.difficulty_name
            %tr
              %td= t("rva.tracks.format.length.title")
              %td= t("rva.tracks.format.length.meters", length:@track.length) #{@track.length}
            %tr
              %td{style: "cursor: help;", :"data-toggle" => "tooltip", :"data-placement" => "top", :title => t("rva.cars.features.stock-tooltip.tooltip")}
                = t("rva.shared.stock.title")
              %td= @track.stock ? t("misc.bool.true") : t("misc.bool.false")
            %tr
              %td{style: "cursor: help;", :"data-toggle" => "tooltip", :"data-placement" => "top", :title => t("rva.cars.features.lego-tooltip.tooltip")}
                = t("rva.shared.lego.title")
              %td= @track.lego ? t("misc.bool.true") : t("misc.bool.false")
        - if @track.season
          %i
            = t("rva.tracks.featured.description", season: @track.season.name) #{@track.season.name}

      .col-md-6
        %img.thumbnail.center-block.img-responsive{src: @track.thumbnail_url, alt: @track.name}
        - if user_is_admin?
          = link_to t("rva.tracks.admin.edit.button"), edit_track_path(@track), :class => "btn mt-2"
          = link_to t("rva.tracks.admin.delete.button"), @track, data: { turbo: true, turbo_method: :delete, turbo_confirm: t("results.admin.delete.confirmation.body") }, :class => "btn mt-2"
