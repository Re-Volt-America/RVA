- content_for :title, "Re-Volt America - #{@car.name}"

- meta :title, @car.name
- meta :description, t("rva.cars.meta.show.description")
- meta :image, @car.thumbnail_url

%h2.mb-4
  = title_with_season(t('rva.cars.title'), @car.season)

= render :partial => "application/subnav", :locals => {:season => @car.season, :category => @car.category, :car => @car}

#tracks
  .container
    .row
      .col-md-6
        %h1{style: "margin-top: 0;"}
          = @car.name
        %br
        %table.car-specs-table
          %tbody
            %tr
              %td= t("rva.cars.features.speed")
              %td= "#{@car.speed} km/h"
            %tr
              %td= t("rva.cars.features.acceleration")
              %td= "#{@car.accel} ms²"
            %tr
              %td= t("rva.cars.features.weight")
              %td= "#{@car.weight} Kg"
            %tr
              %td= t("rva.cars.features.multiplier")
              %td= @car.multiplier
            %tr
              %td= t("rva.cars.features.category")
              %td= category_name(@car.category)
            %tr
              %td= t("rva.cars.features.author")
              %td= @car.author
            %tr
              %td{style: "cursor: help;", :"data-toggle" => "tooltip", :"data-placement" => "top", :title => t("rva.cars.features.stock-tooltip.tooltip")}
                = t("rva.shared.stock.title")
              %td= "#{@car.stock? ? t("misc.bool.true") : t("misc.bool.false")}"
        - if @car.season
          %i
            = t("rva.cars.features.featured-session", season:@car.season.name) #{@car.season.name}

      .col-md-6
        %img.thumbnail.center-block.img-responsive{src: @car.thumbnail_url, alt: @car.name}
        - if user_is_admin?
          = link_to t("rva.cars.edit.button"), edit_car_path(@car), :class => "btn mt-2"
          = link_to t("rva.cars.edit.delete"), @car, data: { turbo: true, turbo_method: :delete, turbo_confirm: t("results.admin.delete.confirmation.body") }, :class => "btn mt-2"
