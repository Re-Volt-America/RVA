- if notice
  .notification.success.show{role: "notification"}
    .notification-content
      %i.fa.fa-check-circle
      %span= notice
    %button.notification-close{"aria-label" => "Close", type: "button"}
      %i.fa.fa-times
    .notification-progress
      .notification-progress-bar
- if alert
  .notification.error.show{role: "notification"}
    .notification-content
      %i.fa.fa-exclamation-triangle
      %span= alert
    %button.notification-close{"aria-label" => "Close", type: "button"}
      %i.fa.fa-times
    .notification-progress
      .notification-progress-bar
