#splash.mb-2
  .jumbotron.main.masthead.container-fluid
    .container
      %span.splash-kicker
        = t("application.splash.kicker")
      %h1
        = ORG::NAME
      %p
        = t("application.splash.description1")
        %br
        = t("application.splash.description2")
      .d-flex.flex-wrap.justify-content-center.mt-4{:style => "gap: 16px;"}
        %a.btn-important{ href: downloads_path }
          = t("application.splash.download-button")
        %a.btn-important-2{ href: weekly_schedules_path }
          = t("application.splash.weekly-schedules-button")
