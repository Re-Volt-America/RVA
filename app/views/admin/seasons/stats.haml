- content_for :title, "RVA - Season Car Usage"

#admin-panel
  .row.mt-4
    .col-md-12
      .d-flex.justify-content-between.align-items-center.mb-3
        %h2.mb-0 Season Car Usage
        = link_to admin_root_path, :class => "btn btn-sm" do
          %i.fa.fa-arrow-left.mr-1
          Back to panel

  - if @seasons.any?
    = form_with :url => admin_season_stats_path, :method => :get, :local => true do
      .form-row.mb-2
        .col-md-4.mb-2
          %label.filter-label{:for => "season_id"} Season
          = select_tag :season_id, options_from_collection_for_select(@seasons, :id, :name, @season&.id.to_s), :class => "form-control"
        .col-md-3.mb-2
          %label.filter-label{:for => "from_date"} From date
          = date_field_tag :from_date, @season_stats_filters[:from_date_value], :class => "form-control"
        .col-md-3.mb-2
          %label.filter-label{:for => "to_date"} To date
          = date_field_tag :to_date, @season_stats_filters[:to_date_value], :class => "form-control"
        .col-md-2.mb-2
          %label.filter-label{:for => "car_category"} Car class
          = select_tag :car_category, options_for_select([["All classes", ""]] + @season_car_category_options, @season_stats_filters[:car_category_value]), :class => "form-control"
      .d-flex.align-items-center.flex-wrap.mb-4
        = submit_tag "Apply filters", :class => "btn btn-sm mr-2 mb-2"
        = link_to "Reset", admin_season_stats_path(:season_id => @season&.id), :class => "btn btn-sm mr-2 mb-2"
        - if @season_car_usage.present?
          = link_to admin_season_stats_export_path(:season_id => @season&.id), :class => "btn btn-sm mb-2" do
            %i.fa.fa-download.mr-1
            Export to Excel

    .row{:data => { :controller => "car-usage-chart", :"car-usage-chart-chart-id-value" => "season-car-usage-chart" }}
      .col-12
        .card.mb-4
          .card-body
            - selected_class_label = @season_stats_filters[:car_category_value].blank? ? "All classes" : (@season_car_category_options.find { |_name, value| value.to_s == @season_stats_filters[:car_category_value] }&.first || "All classes")
            .d-flex.justify-content-between.align-items-start.mb-2
              %div
                %h4.card-title.mb-0
                  = "Car usage in #{@season&.name || 'Season'}"
                %div.car-class-title
                  %i.fa.fa-car.mr-1
                  = "Class: #{selected_class_label}"
              - if @season_car_usage.present?
                %span.count-pill= "#{@season_car_usage.size} cars"
            - if @season_car_usage.present?
              .car-usage-chart
                = bar_chart @season_car_usage, id: "season-car-usage-chart", colors: ["#ffd966"], legend: false, height: "100%", horizontal: true, dataset: { hoverBackgroundColor: "#ffe89a", borderRadius: 3, borderSkipped: false, maxBarThickness: 26, categoryPercentage: 0.86, barPercentage: 0.9 }, library: { responsive: true, maintainAspectRatio: false, layout: { padding: { right: 16 } }, interaction: { mode: "nearest", axis: "y", intersect: false }, animation: { duration: 700, easing: "easeOutQuart" }, scales: { x: { beginAtZero: true, title: { display: true, text: "Times used", color: "#a49fa2", font: { family: "Bahnschrift-Light", size: 13 } }, ticks: { stepSize: 1, precision: 0, color: "#a49fa2", font: { family: "Bahnschrift-Light" } }, grid: { color: "#2b2b2b" }, border: { display: false } }, y: { ticks: { autoSkip: false, color: "#e8e4e6", font: { family: "Bahnschrift-Light" } }, grid: { display: false }, border: { display: false } } }, plugins: { tooltip: { backgroundColor: "#1a1a1a", borderColor: "#646464", borderWidth: 1, titleColor: "#ffd966", bodyColor: "#ffffff", padding: 10, cornerRadius: 3, displayColors: false } } }
              .table-responsive.mt-4
                %table.table.table-sm.car-usage-table.mb-0
                  %thead
                    %tr
                      %th{:style => "width: 3rem;"} #
                      %th{:style => "width: 5rem;"} Box
                      %th Car
                      %th.text-right Times used
                  %tbody
                    - @season_car_usage.each_with_index do |(car_name, uses), index|
                      - car = @season_cars_by_name[car_name.downcase]
                      - row_data = { :"car-usage-chart-target" => "row", :car => car_name }
                      - (row_data[:action] = "click->car-usage-chart#openCar") && (row_data[:"car-path"] = car_path(car)) if car
                      %tr{:data => row_data}
                        %td.usage-rank= index + 1
                        %td.car-box
                          - if car
                            = image_tag car.thumbnail_url, :alt => car_name, :class => "car-box-img", :loading => "lazy"
                        %td.car-name
                          - if car
                            = link_to car_name, car_path(car)
                          - else
                            = car_name
                        %td.text-right= uses
            - else
              %p.empty-note.mb-0 No car usage data available for the selected filters.
  - else
    %p.empty-note.mt-4 No seasons found.
