.devise-wrapper
  .devise-card
    .devise-card-header
      %h2= t('.change_your_password')
      %p Choose a new secure password
    = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f|
      = render "devise/shared/error_messages", resource: resource
      = f.hidden_field :reset_password_token
      .devise-input
        .field.form-group
          = f.label :password, t('.new_password')
          - if @minimum_password_length
            %em= t('devise.shared.minimum_password_length', count: @minimum_password_length)
          = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control", placeholder: "••••••••"
        .field.form-group
          = f.label :password_confirmation, t('.confirm_new_password')
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "••••••••"
      .actions
        = f.button t('.change_my_password'), type: "submit", class: "devise-btn"
      .devise-links
        = render "devise/shared/links"
