- links = []
- if controller_name != 'sessions'
  - links << link_to(t(".sign_in"), new_user_session_path)
- if devise_mapping.registerable? && controller_name != 'registrations'
  - links << link_to(t(".sign_up"), new_registration_path(resource_name))
- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations'
  - links << link_to(t(".forgot_your_password"), new_password_path(resource_name))
- if devise_mapping.confirmable? && controller_name != 'confirmations'
  - links << link_to(t('.didn_t_receive_confirmation_instructions'), new_confirmation_path(resource_name))
- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
  - links << link_to(t('.didn_t_receive_unlock_instructions'), new_unlock_path(resource_name))

= links.join(" <span class='devise-separator'>·</span> ").html_safe

- if devise_mapping.omniauthable?
  - resource_class.omniauth_providers.each do |provider|
    %br/
    = button_to t('.sign_in_with_provider', provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "devise-btn", style: "margin-top: 0.75rem;"
